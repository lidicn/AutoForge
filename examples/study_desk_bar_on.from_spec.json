{
  "id": "study_desk_bar_on",
  "ir_version": "0.2.1",
  "version": 1,
  "mode": "single",
  "name": "书桌前有人则延时开书房显示器挂灯",
  "snapshot": true,
  "enabled": true,
  "nodes": [
    {
      "id": "a1",
      "kind": "on",
      "trigger": {
        "type": "state",
        "entity_id": "binary_sensor.study_desk_motion",
        "to": "on"
      },
      "name": "书桌前有人"
    },
    {
      "id": "w1",
      "kind": "wait",
      "duration": "30s",
      "name": "等 30 秒确认不是路过"
    },
    {
      "id": "d1",
      "kind": "do",
      "adapter": "ha",
      "action": "light.turn_on",
      "params": {
        "entity_id": "light.study_monitor_bar"
      },
      "result_var": "bar_on",
      "name": "开书房显示器挂灯"
    },
    {
      "id": "p1",
      "kind": "pass",
      "name": "结束"
    }
  ],
  "edges": [
    {
      "from": "a1",
      "to": "w1",
      "kind": "then"
    },
    {
      "from": "w1",
      "to": "d1",
      "kind": "then"
    },
    {
      "from": "d1",
      "to": "p1",
      "kind": "then"
    },
    {
      "from": "d1",
      "to": "p1",
      "kind": "on_error"
    }
  ]
}