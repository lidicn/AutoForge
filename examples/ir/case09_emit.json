{
  "ir_version": "0.2.1",
  "id": "study_light_announce",
  "name": "书房开灯并广播事件",
  "version": 1,
  "mode": "restart",
  "snapshot": true,
  "meta": {
    "acceptance": "v0.3.0 emit 发布侧",
    "expect": "开灯成功后发出事件 study_light_on（载荷 room=study）"
  },
  "nodes": [
    {
      "id": "a1",
      "kind": "on",
      "name": "书房检测到人",
      "trigger": {
        "type": "state",
        "entity_id": "binary_sensor.study_motion",
        "to": "on"
      }
    },
    {
      "id": "i1",
      "kind": "if",
      "name": "光照不足且灯是关的",
      "expr": {
        "op": "and",
        "args": [
          {
            "op": "lt",
            "left": { "var": "entity.sensor.study_illum", "type": "numeric" },
            "right": { "const": 200 }
          },
          {
            "op": "is_off",
            "value": { "var": "entity.light.study_main" }
          }
        ]
      }
    },
    {
      "id": "d1",
      "kind": "do",
      "name": "开书房主灯",
      "adapter": "ha",
      "action": "light.turn_on",
      "params": { "entity_id": "light.study_main" }
    },
    {
      "id": "n1",
      "kind": "pass",
      "name": "广播开灯事件",
      "emit": {
        "event": "study_light_on",
        "data": { "room": "study" }
      }
    },
    {
      "id": "p1",
      "kind": "pass",
      "name": "结束"
    }
  ],
  "edges": [
    { "from": "a1", "to": "i1", "kind": "then" },
    { "from": "i1", "to": "d1", "kind": "then" },
    { "from": "i1", "to": "p1", "kind": "no" },
    { "from": "d1", "to": "n1", "kind": "then" },
    { "from": "d1", "to": "p1", "kind": "on_error" }
  ]
}
