{
  "ir_version": "0.2.1",
  "meta": {
    "title": "跨自动化混合环（实体边 + 事件边各贡献一半，emit 解耦良性模式）",
    "expect": "A 由 switch.lamp_x 状态变化触发并 emit event.lamp_x_changed；B 由 event.lamp_x_changed 触发并写 switch.lamp_x。deps 图与 emit_deps 图各自都不是环，但 union 后是环 A→B→A。因环上含 emit 事件解耦边，运行时靠状态收敛+熔断避免死循环（即 case_lamp_sync 的良性双向同步模式），P1-4 union 检测仍会标 CROSS_DEP_CYCLE 但降级为告警（WARNING），不阻断 forge build。用于验收「emit 解耦环放行但可见」；真正危险且无解耦的纯实体环见 invalid_case_entity_cycle.json（被 ENTITY_DEP_CYCLE 拦截）。"
  },
  "automations": [
    {
      "ir_version": "0.2.1",
      "id": "a_emit_on_change",
      "name": "A：开关变化→广播事件",
      "version": 1,
      "mode": "single",
      "meta": {
        "acceptance": "P1-4 盲区（混合跨环）",
        "expect": "由实体状态变化触发，仅 emit 事件（不写实体），故 deps 图无出边"
      },
      "nodes": [
        { "id": "on1", "kind": "on", "name": "开关开了", "trigger": { "type": "state", "entity_id": "switch.lamp_x", "to": "on" } },
        { "id": "e1", "kind": "pass", "name": "广播变化", "emit": { "event": "lamp_x_changed" } },
        { "id": "p1", "kind": "pass", "name": "结束" }
      ],
      "edges": [
        { "from": "on1", "to": "e1", "kind": "then" },
        { "from": "e1", "to": "p1", "kind": "then" }
      ]
    },
    {
      "ir_version": "0.2.1",
      "id": "b_write_on_event",
      "name": "B：收到事件→写开关",
      "version": 1,
      "mode": "single",
      "meta": {
        "acceptance": "P1-4 盲区（混合跨环）",
        "expect": "由事件触发，仅写实体（不 emit），故 emit_deps 图无出边"
      },
      "nodes": [
        { "id": "onA", "kind": "on", "name": "收到变化事件", "trigger": { "type": "event", "event": "lamp_x_changed" } },
        { "id": "dA", "kind": "do", "name": "写开关", "adapter": "ha", "action": "switch.turn_on", "params": { "entity_id": "switch.lamp_x" }, "result_var": "r_x" },
        { "id": "p2", "kind": "pass", "name": "结束" }
      ],
      "edges": [
        { "from": "onA", "to": "dA", "kind": "then" },
        { "from": "dA", "to": "p2", "kind": "then" }
      ]
    }
  ]
}
