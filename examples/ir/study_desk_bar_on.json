{
  "ir_version": "0.2.1",
  "id": "study_desk_bar_on",
  "name": "书桌前有人则延时开书房显示器挂灯",
  "version": 1,
  "mode": "single",
  "snapshot": true,
  "meta": {
    "author": "agent",
    "note": "接手实测：展示 wait 新语义（到点走 then）+ 两道闸 + expect 断言；entity_id 为示意占位，真机需 forge entities resolve 回填"
  },
  "expect": [
    {
      "entity_id": "light.study_monitor_bar",
      "state": "on",
      "note": "wait 30 秒到点走 then 后，挂灯应已点亮"
    }
  ],
  "nodes": [
    {
      "id": "a1",
      "kind": "on",
      "name": "书桌前有人",
      "trigger": { "type": "state", "entity_id": "binary_sensor.study_desk_motion", "to": "on" }
    },
    {
      "id": "w1",
      "kind": "wait",
      "duration": "30s",
      "name": "等 30 秒确认不是路过"
    },
    {
      "id": "d1",
      "kind": "do",
      "name": "开书房显示器挂灯",
      "adapter": "ha",
      "action": "light.turn_on",
      "params": { "entity_id": "light.study_monitor_bar" },
      "result_var": "bar_on"
    },
    { "id": "p1", "kind": "pass", "name": "结束" }
  ],
  "edges": [
    { "from": "a1", "to": "w1", "kind": "then" },
    { "from": "w1", "to": "d1", "kind": "then" },
    { "from": "d1", "to": "p1", "kind": "then" },
    { "from": "d1", "to": "p1", "kind": "on_error" }
  ]
}
