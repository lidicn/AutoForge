# AutoForge 只读服务层镜像（FastAPI）—— 供前端控制台（AutoForge-UI）取数。
#
# 用法（项目根目录）：
#   docker build -f docker/Dockerfile.api -t autoforge-api .
#   docker run --rm -p 8787:8787 -v /vol1/1000/docker/autoforge-store:/data autoforge-api
#
# 端点见容器内 http://<host>:8787/docs （Swagger UI）或 /openapi.json。
# ⚠️ Round 1 只读：不连真实 Home Assistant、不写设备、不需要令牌。

FROM python:3.14-slim
# 基线对齐（v2.0.1/0.1-d）：与 Dockerfile.test 共用同一基础镜像 + 同一 homesdk wheel，
# 确保 api / test 两容器基线一致；依赖差异仅由 pyproject extras（api,ha vs dev）决定。
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY examples ./examples
# 窗后验收与门禁脚本随镜像走：`docker compose exec autoforge python scripts/verify_adm_window.py`
# 是停机窗当天的验收入口，它必须和被测服务在同一台机器上可执行。
COPY scripts ./scripts
# WO-AF-004 打回 5：homesdk 0.3.2 烘进镜像，文件名钉死（不通配，避免多 wheel 静默装错）
COPY docker/homesdk/homesdk-0.3.2-py3-none-any.whl /tmp/homesdk/
RUN pip install --no-cache-dir /tmp/homesdk/homesdk-0.3.2-py3-none-any.whl

# v1.6.0-a：同时装 ha extra（websockets），启用 HA websocket 四注册表；
# 未安装时目录会自动降级（device_id/integration/area 为空），核心能力不受损。
# mqtt extra（paho-mqtt）：homesdk 只把 paho 放在它自家的 [mqtt] extra 里，裸 wheel 不带它
# ⇒ 不装则 `AUTOFORGE_MQTT=1` 时 serve 直接抛 `MqttUnavailable`，联动环在生产面根本起不来，
# 而开发机因手动装过 paho 一切正常。三面一致由 scripts/check_mqtt_runtime_dep.py 钉住。
RUN pip install --no-cache-dir -e ".[api,ha,mqtt]"

# P1-21 修复：非 root 用户运行，防止容器内 RCE 持久化到宿主
# uid=1000/gid=1001 匹配 NAS 宿主 lidicn:Users，确保挂载的 /data  store 目录可写
RUN groupadd --gid 1001 autoforge && useradd --uid 1000 --gid 1001 --home /app --shell /usr/sbin/nologin autoforge
RUN mkdir -p /data && chown -R 1000:1001 /data /app
USER autoforge

EXPOSE 8787

# 启动时把 examples/ir 幂等灌入 /data 归档，让控制台一开就有数据
CMD ["forge", "serve", "--host", "0.0.0.0", "--port", "8787", \
     "--store-root", "/data", "--examples", "/app/examples/ir"]
