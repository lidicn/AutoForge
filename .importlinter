# AutoForge 分层依赖契约（防劣化，非纠错）
# 来源：DCD 裁定 20260930 子决策三（B→A 渐进）。
# 现状 import 方向已健康（service ← api ← cli，无反向），本契约只锁健康方向、防未来劣化。
# 层方向：L2(服务) → L1(运行时) → L0(内核)，禁止反向（低层不得依赖高层）。
# 观察一个版本 / 2 周，确认无合法误伤后，将 CI 步骤由 continue-on-error 升为失败门禁。

[importlinter]
root_packages = autoforge
include_external_packages = False

[importlinter:contract:layers]
name = AutoForge layer architecture (anti-regression)
type = layers
layers =
    autoforge.af_service, autoforge.af_api, autoforge.af_cli
    autoforge.af_runtime, autoforge.af_scanner, autoforge.af_executor, autoforge.af_persist, autoforge.af_state, autoforge.af_store, autoforge.af_scheduler
    autoforge.af_ir, autoforge.af_vhass, autoforge.af_adapters, autoforge.af_flock, autoforge.af_fault
