# AutoForge —— 遵循 E:\NAS\开发规范.md：本地写码、git 管、手动部署，绝不把缓存推到 NAS
.venv/
.venv*/
venv/
venv*/
env/

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# vhass 仿真可能落盘的 HA 配置/数据库
.ha_config/
*.db
*.db-journal

# 本地覆盖配置（含真实 HA token 等，绝不入库）
.env
*.local.json

# v1.4.0 凭据热重载（含真实 HA / API 令牌，绝不入库）
credentials.json
revision.json

# G6 版本化存储默认目录（本地归档，不入库）
.forge/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 开发/调试产物（不入库）
tmp/
*.log
.codebuddy/

# 合并后的前端控制台（ui/ 子目录，原为独立仓库 autoforge-ui）
/ui/node_modules/
/ui/dist/
/ui/*.tsbuildinfo
/ui/build.log
/ui/build.out
/ui/build.err
/ui/build.pid

# AF-KEEPERS (2026-09-19)：归一后禁止此类垃圾长回来
backups/
tests_fresh/
examples_fresh/
tmp_*.py
*.whl

# ── 用户端 WebUI（2026-09-25 补）：依赖与构建产物绝不入库 ──
# 注意：根已有 dist/ 规则，但那是全局的；这里是按前端子目录精确兜底，
# 防止 git add 时把几千个 node_modules / dist 产物灌进版本库。
/ui-user-mimo/node_modules/
/ui-user-mimo/dist/
/ui-user/node_modules/
/ui-user/dist/
# vite 偶发的临时编译产物
*.timestamp-*.mjs

# 工具缓存目录
.qoder/

# pytest --basetemp 临时目录（不入库）
.ptmp/

# 一次性调试脚本（下划线前缀，用完即弃，不入库）
_*.py
_*.sh
_*.conf
