# AutoForge UI — 生产构建环境变量
# 由 `vite build`（默认 mode=production）读取，在构建时内联进产物。
# 部署到 NAS 前务必用本文件构建，否则会回退到 mock / localhost:8787。

# 关闭前端内置 mock，改走真实后端 API
VITE_USE_MOCK=false

# API 基址。相对路径 /api 的前提：前端与后端同源托管——
#   · 推荐：后端 `forge serve --ui-dir dist` 单进程同源（本仓库已支持）
#   · 或 nginx 把 /api 反代到后端 8787
# 若前端独立托管且未做反代，请改为绝对地址：
#   VITE_API_BASE=http://192.168.2.200:8787/api
VITE_API_BASE=/api
