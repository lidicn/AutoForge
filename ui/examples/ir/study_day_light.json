{
  "name": "study_day_light",
  "version": 1,
  "ir": {
    "ir_version": "0.2.1",
    "id": "study_day_light",
    "name": "书房白天人来补光",
    "version": 1,
    "mode": "restart",
    "snapshot": true,
    "meta": {
      "acceptance": "G1 用例 1",
      "expect": "人在 + 光照<200 + 灯灭 → light.study_main = on"
    },
    "nodes": [
      {
        "id": "a1",
        "kind": "on",
        "name": "书房检测到人",
        "trigger": { "type": "state", "entity_id": "binary_sensor.study_motion", "to": "on" }
      },
      {
        "id": "i1",
        "kind": "if",
        "name": "光照不足且灯是关的",
        "expr": {
          "op": "and",
          "args": [
            { "op": "lt", "left": { "var": "entity.sensor.study_illum", "type": "numeric" }, "right": { "const": 200 } },
            { "op": "is_off", "value": { "var": "entity.light.study_main" } }
          ]
        }
      },
      {
        "id": "d1",
        "kind": "do",
        "name": "开书房主灯",
        "adapter": "ha",
        "action": "light.turn_on",
        "params": { "entity_id": "light.study_main" },
        "result_var": "turn_on_result"
      },
      { "id": "p1", "kind": "pass", "name": "结束" }
    ],
    "edges": [
      { "from": "a1", "to": "i1", "kind": "then" },
      { "from": "i1", "to": "d1", "kind": "then" },
      { "from": "i1", "to": "p1", "kind": "no" },
      { "from": "d1", "to": "p1", "kind": "then" },
      { "from": "d1", "to": "p1", "kind": "on_error" }
    ]
  },
  "nl": "当书房运动传感器检测到有人时，如果光照低于200且主灯关闭，则打开书房主灯。",
  "diagnostics": [
    {
      "code": "L2_NEEDS_CONFIRM",
      "level": "warning",
      "message": "L2动作（light.turn_on）建议使用canary+人工确认",
      "automation_id": "study_day_light",
      "node_id": "d1"
    }
  ]
}
